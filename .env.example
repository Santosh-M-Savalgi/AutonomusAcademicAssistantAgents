# Safe local-development defaults. Copy to .env and change only local values.
AAA_PROFILE=mock
APP_ENV=development
LOG_LEVEL=INFO

# Host-side access to the services started by `make up`.
DATABASE_URL=postgresql+asyncpg://aaa:aaa@localhost:5433/aaa
REDIS_URL=redis://localhost:6380/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aaa-minio
MINIO_SECRET_KEY=aaa-minio-secret
MINIO_BUCKET=aaa
MINIO_SECURE=false
HEALTHCHECK_TIMEOUT_SECONDS=2.0
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_PDF_PAGES=500
UPLOAD_CHUNK_SIZE_BYTES=1048576

# The development secret is a placeholder for local work only.
# Never use it outside a local environment.
APP_SECRET_KEY=change-me-in-a-local-.env

# JWT signing: generate a unique random value of at least 32 characters and put it in .env.
# Tokens cannot be issued or validated until JWT_SECRET_KEY is configured.
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=aaa-v3
JWT_AUDIENCE=aaa-v3-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id password hashing parameters (KiB memory cost).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# Standalone durable worker (requires the Sprint 2.1 migration).
# Syllabus extraction is registered; unsupported types fail UNKNOWN_JOB_TYPE.
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_REAPER_SECONDS=15
WORKER_RETRY_BASE_SECONDS=2
WORKER_RETRY_MAX_SECONDS=300
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_IO_TIMEOUT_SECONDS=5
WORKER_LANES=["interactive","prefetch","batch"]

# Deterministic PDF extraction; shares MAX_UPLOAD_SIZE_BYTES and MAX_PDF_PAGES above.
EXTRACTION_TIMEOUT_SECONDS=60
EXTRACTION_MAX_OUTPUT_BYTES=4194304
EXTRACTION_MEMORY_MB=512
EXTRACTION_MINIMUM_USEFUL_CHARACTERS=40

# Curriculum draft generation; output is always an unconfirmed DRAFT.
DRAFT_TIMEOUT_SECONDS=30
DRAFT_ARTIFACT_MAX_BYTES=4194304
DRAFT_MAX_SECTIONS=128
DRAFT_UNIT_OUTPUT_MAX_BYTES=65536
