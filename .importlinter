[importlinter]
root_packages =
    packages
    apps
include_external_packages = true

[importlinter:contract:domain-boundary]
name = Domain does not depend on other internal packages
type = forbidden
source_modules =
    packages.domain
forbidden_modules =
    packages.mastery
    packages.planner
    packages.curriculum
    packages.retrieval
    packages.agents
    packages.model_client
    packages.persistence
    packages.evalkit

[importlinter:contract:mastery-boundary]
name = Mastery may depend only on domain
type = layers
layers =
    packages.mastery
    packages.domain

[importlinter:contract:planner-boundary]
name = Planner may depend only on domain
type = layers
layers =
    packages.planner
    packages.domain

[importlinter:contract:api-boundary]
name = API does not depend on agents or model clients
type = forbidden
source_modules =
    apps.api
forbidden_modules =
    packages.agents
    packages.model_client

[importlinter:contract:model-client-boundary]
name = Model client does not depend on the gateway implementation
type = forbidden
source_modules =
    packages.model_client
forbidden_modules =
    apps.model_gateway

[importlinter:contract:agent-model-boundary]
name = Agents use the model client abstraction, not gateway providers
type = forbidden
source_modules =
    packages.agents
forbidden_modules =
    apps.model_gateway

[importlinter:contract:planner-purity]
name = Planner has no infrastructure, environment, clock, graph or mastery dependencies
type = forbidden
source_modules =
    packages.planner
forbidden_modules =
    apps
    packages.persistence
    packages.mastery
    packages.curriculum
    packages.agents
    packages.model_client
    packages.retrieval
    packages.evalkit
    asyncio
    datetime
    fastapi
    httpx
    minio
    os
    pathlib
    random
    redis
    requests
    secrets
    socket
    sqlalchemy
    subprocess
    time
    urllib
allow_indirect_imports = true

[importlinter:contract:agent-boundary]
name = Agents do not depend on persistence
type = forbidden
source_modules =
    packages.agents
forbidden_modules =
    packages.persistence

[importlinter:contract:graph-purity]
name = Graph algorithms do not depend on I/O, framework, clock or network modules
type = forbidden
source_modules =
    packages.curriculum.graph
    packages.curriculum.templates
    packages.domain.graph
forbidden_modules =
    apps
    packages.persistence
    packages.agents
    packages.model_client
    packages.mastery
    packages.planner
    packages.evalkit
    packages.retrieval
    packages.curriculum.config
    packages.curriculum.pdf
    packages.curriculum.drafts
    packages.curriculum.structure
    aiohttp
    asyncio
    datetime
    fastapi
    http
    httpx
    minio
    os
    pathlib
    random
    redis
    requests
    secrets
    socket
    sqlalchemy
    subprocess
    time
    urllib
    urllib3
ignore_imports =
    packages.domain.models -> datetime
